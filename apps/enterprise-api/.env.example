# Enterprise AI Platform Environment Configuration Template

# API Server Settings
PROJECT_NAME="AI Document Q&A API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"

# Database Configuration
DATABASE_URL="sqlite:///./enterprise_ai.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_ai_db"

# Qdrant Vector Store Configuration
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="enterprise_documents_v2"
LEGACY_QDRANT_COLLECTION="enterprise_documents"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_CACHE_DIR="./.cache/fastembed"

# LLM Provider API Keys (Optional - Can also be provided via Web Playground UI)
# Set ALLOW_SERVER_KEY=true to allow authenticated chat requests to use server GROQ_API_KEY (default: false)
ALLOW_SERVER_KEY=false
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
